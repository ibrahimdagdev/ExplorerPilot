<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExplorerPilot.Infrastructure</RootNamespace>
    <AssemblyName>ExplorerPilot.Infrastructure</AssemblyName>
    <!-- Windows WMI APIs; project targets Windows desktop via the App host. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExplorerPilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExplorerPilot.Core\ExplorerPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
