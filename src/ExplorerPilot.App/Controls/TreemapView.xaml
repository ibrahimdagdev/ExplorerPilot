<UserControl x:Class="ExplorerPilot.App.Controls.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExplorerPilot.App.Controls"
             Focusable="True">
    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderBrushKey}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <local:TreemapCanvas x:Name="Canvas"
                             Layout="{Binding Layout}"
                             SelectedId="{Binding SelectedRectangleId, Mode=TwoWay}"
                             FocusedId="{Binding FocusedRectangleId, Mode=TwoWay}"
                             ToolTipService.ShowDuration="20000"
                             ToolTipService.InitialShowDelay="400" />
    </Border>
</UserControl>
