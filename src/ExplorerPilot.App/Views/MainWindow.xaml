                                                    Command="{Binding Trends.RefreshCatalogCommand}"
                                                    Margin="0,0,8,0"
                                                    MinWidth="110" />
                                            <Button Content="{DynamicResource Trends_AnalyzeButton}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Trends.AnalyzeCommand}"
