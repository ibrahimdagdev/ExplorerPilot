                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Cleanup_Card_UniquePaths}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Cleanup.UniquePathsText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Cleanup_Card_Candidates}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Cleanup.CandidateCountText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="6" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
