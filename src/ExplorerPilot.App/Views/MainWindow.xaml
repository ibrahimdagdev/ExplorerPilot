                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnCategory}" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnFirst}" Binding="{Binding FirstText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnLast}" Binding="{Binding LastText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnPercent}" Binding="{Binding PercentText}" Width="90" />
