                                                    MinWidth="100"
                                                    Visibility="{Binding Trends.IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
