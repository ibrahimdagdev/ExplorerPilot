                                            <Run Text=" / " />
                                            <Run Text="{Binding Cleanup.SelectedSizeText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Cleanup.SelectedCountText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Cleanup.SelectedRiskSummaryText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
