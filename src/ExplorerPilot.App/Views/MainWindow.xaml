                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnPath}" Binding="{Binding FullPath}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnSize}" Binding="{Binding SizeText}" Width="100" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnSavings}" Binding="{Binding SavingsText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnModified}" Binding="{Binding ModifiedText}" Width="130" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnCategory}" Binding="{Binding CategoryText}" Width="120" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnRisk}" Binding="{Binding RiskText}" Width="90" />
                                            <DataGridTextColumn Header="{DynamicResource Cleanup_ColumnReason}" Binding="{Binding ReasonText}" Width="180" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Trends_Title}">
