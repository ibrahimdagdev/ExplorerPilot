                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Trends.DownsampledWarningVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Trends_FolderRenameCaveat}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Trends.FolderCaveatVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Trends.StatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Trends.ProgressText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Visibility="{Binding Trends.IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="6" Style="{StaticResource WorkspaceTabControlStyle}">
                                <TabItem Header="{DynamicResource Trends_Timeline}">
                                    <DataGrid ItemsSource="{Binding Trends.TimelineRows}"
                                              Style="{StaticResource LargestFilesDataGridStyle}"
                                              EnableRowVirtualization="True"
                                              Margin="0,8,0,0">
