                                                                Points="{Binding Trends.ChartPoints}"
                                                                SelectedIndex="{Binding Trends.SelectedChartIndex, Mode=TwoWay}"
                                                                AccessibilitySummary="{Binding Trends.ChartAccessibilitySummary}"
                                                                LineBrush="{DynamicResource AccentBrush}"
                                                                IncompleteBrush="{DynamicResource DangerBrush}"
                                                                AxisBrush="{DynamicResource TextMutedBrush}"
                                                                SelectionBrush="{DynamicResource TextPrimaryBrush}"
                                                                Focusable="True"
                                                                KeyboardNavigation.IsTabStop="True" />
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Trends.ComparisonRangeText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Trends.HasSeries, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Trends.SelectedPointSummary}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding Trends.HasSeries, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Trends_ChartKeyboardHint}"
