                                                      SelectedItem="{Binding ScheduledScans.SelectedWeekday, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName" Margin="0,0,0,8" />
                                            <TextBlock Text="{DynamicResource Scheduled_MonthDay}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBox Text="{Binding ScheduledScans.MonthlyDay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                            <CheckBox Content="{DynamicResource Scheduled_EnabledFlag}"
                                                      IsChecked="{Binding ScheduledScans.EditorEnabled, Mode=TwoWay}" Margin="0,0,0,12" />
                                            <WrapPanel>
                                                <Button Content="{DynamicResource Scheduled_Toggle}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding ScheduledScans.ToggleEnabledCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource Scheduled_RunNow}" Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding ScheduledScans.RunNowCommand}" Margin="0,0,8,8" />
                                                <Button Content="{DynamicResource Scheduled_Cancel}" Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding ScheduledScans.CancelRunCommand}" Margin="0,0,8,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Activity_Title}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ScanStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="200"
                                       ToolTip="{Binding ScanStatus}" />
                        </DockPanel>

                        <!-- Progress only while scanning/exporting; collapsed when Ready/idle (no empty full-bleed track). -->
                        <ProgressBar IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource ScanActivityProgressBarStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Activity_CurrentPath}" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding CurrentPathText}"
                                       Style="{StaticResource BodyTextStyle}"
                                       ToolTip="{Binding CurrentPathText}"
                                       MinHeight="18" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Activity_Files}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding ProgressFilesText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Activity_Folders}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding ProgressFoldersText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Activity_LogicalSize}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding ProgressBytesText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Activity_Elapsed}" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding ProgressElapsedText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrushKey}"
                                Margin="0,14,0,12"
                                Opacity="0.8" />

                        <DockPanel>
                            <TextBlock Text="{DynamicResource Activity_ErrorsSkipped}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Text="{Binding SummaryErrorsText}"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="14" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource ScanSummary_Title}"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="{Binding SummaryCompletenessText}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource ScanSummary_TotalFiles}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SummaryFilesText}" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource ScanSummary_TotalFolders}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SummaryFoldersText}" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource ScanSummary_LogicalSize}" Style="{StaticResource MetricLabelStyle}" />
                                    <TextBlock Text="{Binding SummarySizeText}"
                                               Style="{StaticResource MetricValueStyle}"
                                               FontSize="20" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource ScanSummary_Duration}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SummaryDurationText}" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource ScanSummary_SkippedErrors}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding SummaryErrorsText}" Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
