                                    <TextBlock Text="{DynamicResource Cleanup_NoScan}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>

                                <DockPanel Visibility="{Binding Cleanup.HasScanRoot, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="{DynamicResource Cleanup_OpenContainingFolder}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Cleanup.OpenContainingFolderCommand}"
                                                Margin="0,0,8,0"
                                                MinWidth="160" />
                                        <Button Content="{DynamicResource Cleanup_CopyPath}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Cleanup.CopyPathCommand}"
                                                MinWidth="120" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding Cleanup.VisibleCandidates}"
                                              SelectedItem="{Binding Cleanup.SelectedCandidate, Mode=TwoWay}"
                                              Style="{StaticResource LargestFilesDataGridStyle}"
