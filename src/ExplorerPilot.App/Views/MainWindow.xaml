                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnDate}" Binding="{Binding DateText}" Width="140" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnName}" Binding="{Binding DisplayName}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnSize}" Binding="{Binding SizeText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnPercent}" Binding="{Binding PercentText}" Width="90" />
                                            <DataGridTextColumn Header="{DynamicResource Trends_ColumnStatus}" Binding="{Binding StatusText}" Width="100" />
