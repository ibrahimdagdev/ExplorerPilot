<Window x:Class="ExplorerPilot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ExplorerPilot.App.Converters"
        xmlns:controls="clr-namespace:ExplorerPilot.App.Controls"
        xmlns:vm="clr-namespace:ExplorerPilot.App.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource App_Name}"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:PercentageConverter x:Key="PercentageConverter" />
        <converters:DriveDisplayConverter x:Key="DriveDisplayConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header toolbar (horizontal scroll on narrow / high-DPI layouts) -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}">
            <!-- Hidden (not Auto): avoids a thin full-width scrollbar strip under the toolbar chrome. -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          CanContentScroll="False">
            <Grid MinWidth="980">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path Fill="{DynamicResource AccentForegroundBrush}"
                                  Data="M2,2 H10 V6 H14 V14 H2 Z M4,4 V12 H12 V8 H8 V4 Z" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{DynamicResource App_Name}" Style="{StaticResource BrandTitleStyle}" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableDrives}"
                              SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                              ToolTip="{Binding SelectedDrive, Converter={StaticResource DriveDisplayConverter}}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDiscoveringDrives}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource DriveDisplayConverter}}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding DriveSelectorStatus}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,40,0"
                               Style="{StaticResource MutedTextStyle}"
                               Visibility="{Binding IsDiscoveringDrives, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Button_BrowseFolder}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BrowseFolderCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Button_ExportReport}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportReportCommand}"
                            ToolTip="{DynamicResource Report_ButtonTooltip}" />
                </StackPanel>

                <ComboBox Grid.Column="6"
                          Style="{StaticResource ThemeSelectorComboBoxStyle}"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          SelectedValuePath="Mode"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{DynamicResource Theme_SelectorTooltip}"
                          VerticalAlignment="Center" />

                <ComboBox Grid.Column="8"
                          Style="{StaticResource ThemeSelectorComboBoxStyle}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{DynamicResource Language_SelectorTooltip}"
                          VerticalAlignment="Center" />

                <Button Grid.Column="10"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowSystemInformationCommand}"
                        ToolTip="{DynamicResource SystemInfo_ButtonTooltip}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource SystemInfo_Title}">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M2,3 H14 V13 H2 Z M4,5 V11 H12 V5 Z M5.5,6.5 H7 V8 H5.5 Z M8.5,6.5 H10.5 V7.5 H8.5 Z M5.5,9 H10.5 V10 H5.5 Z" />
                    </Viewbox>
                </Button>

                <Button Grid.Column="12"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ShowAboutCommand}"
                        ToolTip="{DynamicResource About_ButtonTooltip}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource About_Title}">
                    <Viewbox Width="16" Height="16" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M8,1.5 A6.5,6.5 0 1 0 8,14.5 A6.5,6.5 0 1 0 8,1.5 Z M7.25,4.25 H8.75 V5.75 H7.25 Z M7.25,7 H8.75 V12 H7.25 Z" />
                    </Viewbox>
                </Button>

                <StackPanel Grid.Column="14" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Button_StartScan}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ScanCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Button_CancelScan}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelScanCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Button_CancelExport}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelExportCommand}"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Storage summary -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Summary_TotalCapacity}" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding DriveCapacityText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Summary_UsedSpace}" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding DriveUsedText}" Style="{StaticResource MetricValueStyle}" />
                    <ProgressBar Style="{StaticResource UtilizationBarStyle}"
                                 Value="{Binding DriveUsageRatio, Mode=OneWay}"
                                 Margin="0,10,0,0"
                                 ToolTip="{Binding DriveUsagePercentText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Summary_FreeSpace}" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding DriveFreeText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource SummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Summary_SelectedPathStatus}" Style="{StaticResource MetricLabelStyle}" />
                    <TextBlock Text="{Binding TargetPathText}"
                               Style="{StaticResource MetricValueStyle}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding TargetPathText}" />
                    <TextBlock Text="{Binding ScanStatus}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ScanStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main workspace -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="35*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl Style="{StaticResource WorkspaceTabControlStyle}"
                            SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
                    <!-- Professional dashboard (v2.0 Phase 2) -->
                    <TabItem Header="{DynamicResource Dashboard_Title}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="4,0,4,12">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource Dashboard_Refresh}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Dashboard.RefreshCommand}"
                                            Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Dashboard_Title}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                        <TextBlock Text="{DynamicResource Dashboard_Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Dashboard.StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- KPI row -->
                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard_Kpi_Drives}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Dashboard.DriveCountText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard_Kpi_Capacity}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Dashboard.TotalCapacityText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard_Kpi_Used}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Dashboard.UsedSpaceText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ProgressBar Style="{StaticResource UtilizationBarStyle}" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding Dashboard.UsageRatio, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Dashboard.UsageText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Dashboard_Kpi_Free}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Dashboard.FreeSpaceText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{DynamicResource Dashboard_HighestUsage}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Dashboard.HighestUsageDriveText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Grid.Row="2" Text="{DynamicResource Dashboard_CapacityNote}"
                                           Style="{StaticResource MutedTextStyle}" Margin="8,0,8,12" TextWrapping="Wrap" />

                                <!-- Drives + last scan -->
                                <Grid Grid.Row="3" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12" MinHeight="220">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard_DrivesSection}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                            <ListBox ItemsSource="{Binding Dashboard.DriveRows}"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     MaxHeight="280">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0,4" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8" Margin="0,0,0,6" CornerRadius="8"
                                                                Background="{DynamicResource BgControlBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}" />
                                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource MutedTextStyle}" />
                                                                    <ProgressBar Style="{StaticResource UtilizationBarStyle}" Margin="0,6,0,4" Minimum="0" Maximum="1"
                                                                                 Value="{Binding UsageRatio, Mode=OneWay}" />
                                                                    <TextBlock Style="{StaticResource MutedTextStyle}">
                                                                        <Run Text="{Binding UsedText, Mode=OneWay}" />
                                                                        <Run Text=" / " />
                                                                        <Run Text="{Binding TotalText, Mode=OneWay}" />
                                                                        <Run Text=" (" />
                                                                        <Run Text="{Binding UsageText, Mode=OneWay}" />
                                                                        <Run Text=")" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{DynamicResource Dashboard_ScanDrive}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding DataContext.Dashboard.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding CanScan}"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12" MinHeight="220">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Dashboard_LastScan}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource Dashboard_OpenExplorer}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding Dashboard.OpenExplorerCommand}" Margin="8,0,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{DynamicResource Dashboard_NoScan}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                                       Visibility="{Binding Dashboard.HasScanSummary, Converter={StaticResource BoolToVisInvert}}" />
                                            <StackPanel Visibility="{Binding Dashboard.HasScanSummary, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Dashboard_ScanRoot}" Style="{StaticResource MetricLabelStyle}" />
                                                <TextBlock Text="{Binding Dashboard.ScanRootText}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Dashboard.ScanRootText}" />
                                                <TextBlock Text="{DynamicResource Dashboard_ScanTime}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.ScanTimeText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_ScanSize}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.ScanSizeText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_ScanCounts}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.ScanCountsText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_ScanDuration}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.ScanDurationText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_IncompleteWarning}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding Dashboard.ShowIncompleteWarning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Analysis lists -->
                                <Grid Grid.Row="4" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard_LargestFiles}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                            <ListBox ItemsSource="{Binding Dashboard.LargestFiles}" BorderThickness="0" Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True" MaxHeight="260">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Dashboard_OpenInExplorer}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.Dashboard.RevealPathCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                                    CommandParameter="{Binding}" Margin="8,0,0,0" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedTextStyle}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Dashboard_LargestFolders}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource Dashboard_OpenTreemap}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding Dashboard.OpenTreemapCommand}" Margin="8,0,0,0" />
                                            </DockPanel>
                                            <ListBox ItemsSource="{Binding Dashboard.LargestFolders}" BorderThickness="0" Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True" MaxHeight="260">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedTextStyle}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Dashboard_Categories}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                                            <ListBox ItemsSource="{Binding Dashboard.Categories}" BorderThickness="0" Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True" MaxHeight="260">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentageText}" Style="{StaticResource MutedTextStyle}" />
                                                            </DockPanel>
                                                            <ProgressBar Style="{StaticResource UtilizationBarStyle}" Margin="0,4,0,2" Minimum="0" Maximum="1"
                                                                         Value="{Binding UsageRatio, Mode=OneWay}" />
                                                            <TextBlock Style="{StaticResource MutedTextStyle}">
                                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding FileCountText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <!-- Snapshot + cleanup -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Dashboard_Snapshots}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource Dashboard_OpenTrends}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding Dashboard.OpenTrendsCommand}" Margin="8,0,0,0" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Dashboard.SnapshotEmptyText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                                       Visibility="{Binding Dashboard.HasSnapshotSummary, Converter={StaticResource BoolToVisInvert}}" />
                                            <StackPanel Visibility="{Binding Dashboard.HasSnapshotSummary, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Dashboard_SnapshotLast}" Style="{StaticResource MetricLabelStyle}" />
                                                <TextBlock Text="{Binding Dashboard.SnapshotLastText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_SnapshotDelta}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.SnapshotDeltaText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="4" Padding="12">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource Dashboard_Cleanup}" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                                                <Button DockPanel.Dock="Right" Content="{DynamicResource Dashboard_OpenCleanup}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding Dashboard.OpenCleanupCommand}" Margin="8,0,0,0" />
                                            </DockPanel>
                                            <StackPanel Visibility="{Binding Dashboard.HasCleanupSummary, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Dashboard_CleanupSavings}" Style="{StaticResource MetricLabelStyle}" />
                                                <TextBlock Text="{Binding Dashboard.CleanupSavingsText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_CleanupCount}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.CleanupCountText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{DynamicResource Dashboard_CleanupRisk}" Style="{StaticResource MetricLabelStyle}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding Dashboard.CleanupRiskText}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Dashboard.CleanupPreviewNote}" Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Multi-drive overview (v2.0 Phase 1) — existing module tabs keep relative order -->
                    <TabItem Header="{DynamicResource Drives_Title}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,12"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="{DynamicResource Drives_Refresh}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RefreshDrivesCommand}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Drives_Title}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0" />
                                        <TextBlock Text="{DynamicResource Drives_Subtitle}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="16,12,16,0"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Background="{DynamicResource BgControlBrush}"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Drives_CapacityNote}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Drives_SingleScanNote}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="8,8,8,12">
                                <TextBlock Text="{DynamicResource Drives_Empty}"
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="24"
                                           Visibility="{Binding HasDriveCards, Converter={StaticResource BoolToVisInvert}}" />

                                <ListBox ItemsSource="{Binding DriveCards}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         Visibility="{Binding HasDriveCards, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SummaryCardStyle}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding TitleText}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Style="{StaticResource MutedTextStyle}">
                                                            <Run Text="{Binding KindText, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding FileSystemText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Row="0" Grid.Column="1"
                                                            Content="{DynamicResource Drives_ScanDrive}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanScan}"
                                                            MinWidth="120"
                                                            VerticalAlignment="Center" />

                                                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                 Style="{StaticResource UtilizationBarStyle}"
                                                                 Margin="0,12,0,8"
                                                                 Minimum="0"
                                                                 Maximum="1"
                                                                 Value="{Binding UsageRatio, Mode=OneWay}"
                                                                 IsEnabled="{Binding IsReady}" />

                                                    <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                 Columns="4"
                                                                 Margin="0,0,0,0">
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{DynamicResource Drives_Total}" Style="{StaticResource MetricLabelStyle}" />
                                                            <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{DynamicResource Drives_Used}" Style="{StaticResource MetricLabelStyle}" />
                                                            <TextBlock Text="{Binding UsedText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{DynamicResource Drives_Free}" Style="{StaticResource MetricLabelStyle}" />
                                                            <TextBlock Text="{Binding FreeText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource Drives_Usage}" Style="{StaticResource MetricLabelStyle}" />
                                                            <TextBlock Text="{Binding UsageText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Directory Explorer -->
                    <TabItem Header="{DynamicResource Explorer_Title}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,12"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource Explorer_Title}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{DynamicResource Explorer_Subtitle}"
                                               Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="44,8,16,8"
                                    Background="{DynamicResource BgControlBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Explorer_ColumnName}" Style="{StaticResource MetricLabelStyle}" Margin="0" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Explorer_ColumnSize}" Style="{StaticResource MetricLabelStyle}" Margin="0" TextAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Explorer_ColumnPercent}" Style="{StaticResource MetricLabelStyle}" Margin="0" TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2"
                                  Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisInvert}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="10"
                                            Background="{DynamicResource BgControlBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,16">
                                        <Viewbox Width="18" Height="18">
                                            <Path Fill="{DynamicResource TextSecondaryBrush}"
                                                  Data="M2,2 H10 V6 H14 V14 H2 Z" />
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Explorer_EmptyTitle}"
                                               Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource Explorer_EmptySubtitle}"
                                               Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>
                            </Grid>

                            <TreeView x:Name="ExplorerTree"
                                      Grid.Row="2"
                                      ItemsSource="{Binding TreeRoots}"
                                      Margin="8,4,8,12"
                                      SelectedItemChanged="ExplorerTree_SelectedItemChanged"
                                      Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid MinHeight="26" Margin="0,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="16"
                                                    Height="14"
                                                    CornerRadius="2"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Opacity="0.85">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource GlyphFileBrush}" />
                                                                <Setter Property="Width" Value="12" />
                                                                <Setter Property="Height" Value="14" />
                                                                <Setter Property="CornerRadius" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}">
                                                <Run Text="{Binding Name, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Run Text="{Binding StatusHint, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="11" />
                                            </TextBlock>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PercentageOfParent, Converter={StaticResource PercentageConverter}}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <!-- Largest Files -->
                    <TabItem Header="{DynamicResource LargestFiles_Title}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,12"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LargestFiles_Title}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource LargestFiles_ShowTop}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ComboBox Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  ItemsSource="{Binding LargestFilesLimitOptions}"
                                                  SelectedItem="{Binding SelectedLargestFilesLimit, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  MinWidth="110"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="{DynamicResource LargestFiles_OpenContainingFolder}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenContainingFolderCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource LargestFiles_CopyPath}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CopyPathCommand}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="16,8,16,0">
                                <TextBlock Text="{DynamicResource LargestFiles_IncompleteWarning}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding LargestFilesIncomplete, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding LargestFilesStatusText}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="8,4,8,12">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24"
                                            Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisInvert}}">
                                    <TextBlock Text="{DynamicResource LargestFiles_EmptyTitle}"
                                               Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource LargestFiles_EmptySubtitle}"
                                               Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasScanResults}" Value="True" />
                                                        <Condition Binding="{Binding HasLargestFiles}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource LargestFiles_NoFilesFound}"
                                               Style="{StaticResource EmptyTitleStyle}" />
                                </StackPanel>

                                <DataGrid x:Name="LargestFilesGrid"
                                          ItemsSource="{Binding LargestFiles}"
                                          SelectedItem="{Binding SelectedLargestFile, Mode=TwoWay}"
                                          Style="{StaticResource LargestFilesDataGridStyle}"
                                          Visibility="{Binding HasLargestFiles, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource LargestFiles_OpenContainingFolder}"
                                                      Command="{Binding OpenContainingFolderCommand}" />
                                            <MenuItem Header="{DynamicResource LargestFiles_CopyPath}"
                                                      Command="{Binding CopyPathCommand}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" MinWidth="120">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesNameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SizeText}" Width="90" MinWidth="80">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesSizeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Extension}" Width="80" MinWidth="70">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesExtensionHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ModifiedText}" Width="140" MinWidth="110">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesModifiedHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ParentDirectory}" Width="1.4*" MinWidth="120">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesParentHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding FullPath}" Width="2*" MinWidth="160">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.LargestFilesPathHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- File Types -->
                    <TabItem Header="{DynamicResource FileTypes_Title}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="16,12"
                                    BorderBrush="{DynamicResource BorderBrushKey}"
                                    BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource FileTypes_Title}"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <TextBox DockPanel.Dock="Right"
                                             Width="220"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="{Binding FileTypesFilter, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource FileTypes_SearchTooltip}" />
                                </DockPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="16,10,16,0">
                                <TextBlock Text="{DynamicResource FileTypes_IncompleteWarning}"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding FileTypesIncomplete, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVisInvert}}">
                                    <TextBlock Text="{DynamicResource FileTypes_EmptyTitle}"
                                               Style="{StaticResource EmptyTitleStyle}"
                                               Margin="0,24,0,0" />
                                    <TextBlock Text="{DynamicResource FileTypes_EmptySubtitle}"
                                               Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource FileTypes_AnalyzedFiles}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding FileTypesAnalyzedFilesText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource FileTypes_TotalLogicalBytes}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding FileTypesTotalBytesText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource FileTypes_UniqueExtensions}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding FileTypesUniqueExtensionsText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Margin="12,12,12,12"
                                  Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" MinHeight="160" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource FileTypes_CategoryBreakdown}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding FileCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="72" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="{Binding CategoryName}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                                   Text="{Binding SizeText}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                                   Text="{Binding PercentageText}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center" />

                                                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                                     Style="{StaticResource UtilizationBarStyle}"
                                                                     Value="{Binding UsageRatio, Mode=OneWay}"
                                                                     Maximum="1"
                                                                     Height="6"
                                                                     Margin="0,6,0,0" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                   Text="{Binding FileCountText}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   Margin="0,14,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DataGrid x:Name="FileTypesGrid"
                                          Grid.Row="2"
                                          ItemsSource="{Binding FileExtensions}"
                                          Style="{StaticResource LargestFilesDataGridStyle}"
                                          Visibility="{Binding HasFileTypeStatistics, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding ExtensionText}" Width="100" MinWidth="80">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesExtensionHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding CategoryName}" Width="120" MinWidth="90">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesCategoryHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding FileCountText}" Width="100" MinWidth="80">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesFileCountHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding SizeText}" Width="110" MinWidth="90">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesTotalSizeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding PercentageText}" Width="90" MinWidth="70">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesPercentageHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding AverageSizeText}" Width="*" MinWidth="100">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataContext.FileTypesAverageSizeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                </DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Search Files -->
                    <TabItem Header="{DynamicResource Search_Title}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Search_QueryTooltip}" />
                                        <ComboBox Grid.Column="2"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="140"
                                                  MaxWidth="180"
                                                  ItemsSource="{Binding Search.ScopeOptions}"
                                                  SelectedItem="{Binding Search.SelectedScope, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="{DynamicResource Search_ScopeTooltip}" />
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="130"
                                                  MaxWidth="160"
                                                  ItemsSource="{Binding Search.ItemKindOptions}"
                                                  SelectedItem="{Binding Search.SelectedItemKind, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Search.ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Search_ExtensionTooltip}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{DynamicResource Search_MinSize}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="4"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Search.MinSizeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="6"
                                                   Text="{DynamicResource Search_MaxSize}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="8"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Search.MaxSizeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Grid.Column="10"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="72"
                                                  MaxWidth="90"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Search.SizeUnitOptions}"
                                                  SelectedItem="{Binding Search.SelectedSizeUnit, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Search_ModifiedFrom}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="2"
                                                    Style="{StaticResource SearchDatePickerStyle}"
                                                    SelectedDate="{Binding Search.ModifiedFrom, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{DynamicResource Search_ModifiedTo}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <DatePicker Grid.Column="6"
                                                    Style="{StaticResource SearchDatePickerStyle}"
                                                    SelectedDate="{Binding Search.ModifiedTo, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="8"
                                                   Text="{DynamicResource Search_SortBy}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="10"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="120"
                                                  MaxWidth="150"
                                                  ItemsSource="{Binding Search.SortOptions}"
                                                  SelectedItem="{Binding Search.SelectedSort, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                    </Grid>

                                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                                        <Button Content="{DynamicResource Search_Search}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding Search.SearchCommand}"
                                                Margin="0,0,8,0"
                                                MinWidth="96" />
                                        <Button Content="{DynamicResource Search_ClearFilters}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Search.ClearFiltersCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Search_Cancel}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding Search.CancelSearchCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Search_OpenContainingFolder}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Search.OpenContainingFolderCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Search_CopyPath}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Search.CopyPathCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding Search.HasSearchRoot, Converter={StaticResource BoolToVisInvert}}">
                                    <TextBlock Text="{DynamicResource Search_EmptyTitle}"
                                               Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource Search_EmptySubtitle}"
                                               Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <Grid Visibility="{Binding Search.HasSearchRoot, Converter={StaticResource BoolToVis}}">
                                    <StackPanel VerticalAlignment="Top" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource Search_IncompleteWarning}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Search.FromIncompleteScanVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Search_TruncatedWarning}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding Search.ResultsTruncatedVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Search.StatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <ProgressBar IsIndeterminate="True"
                                                     Height="4"
                                                     Margin="0,8,0,0"
                                                     Visibility="{Binding Search.IsSearching, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <DataGrid x:Name="SearchResultsGrid"
                                              Margin="0,56,0,0"
                                              ItemsSource="{Binding Search.Results}"
                                              SelectedItem="{Binding Search.SelectedResult, Mode=TwoWay}"
                                              Style="{StaticResource LargestFilesDataGridStyle}"
                                              Visibility="{Binding Search.HasResults, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource Search_OpenContainingFolder}"
                                                          Command="{Binding Search.OpenContainingFolderCommand}" />
                                                <MenuItem Header="{DynamicResource Search_CopyPath}"
                                                          Command="{Binding Search.CopyPathCommand}" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Binding="{Binding Name}" Width="1.1*" MinWidth="100">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.NameHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding TypeText}" Width="80" MinWidth="70">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.TypeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding SizeText}" Width="90" MinWidth="80">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.SizeHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding ModifiedText}" Width="130" MinWidth="110">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.ModifiedHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding ParentPath}" Width="1.2*" MinWidth="120">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.ParentHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding FullPath}" Width="1.6*" MinWidth="140">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataContext.Search.PathHeader, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                    </DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>

                            <DockPanel Grid.Row="4" LastChildFill="False">
                                <TextBlock Text="{Binding Search.PageInfoText}"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Search_PreviousPage}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Search.PreviousPageCommand}"
                                            Margin="0,0,8,0"
                                            MinWidth="110" />
                                    <Button Content="{DynamicResource Search_NextPage}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Search.NextPageCommand}"
                                            MinWidth="110" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </TabItem>

                    <!-- Duplicate Files -->
                    <TabItem Header="{DynamicResource Duplicates_Title}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Duplicates.NameFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Duplicates_NameFilter}" />
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Duplicates.ExtensionFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{DynamicResource Duplicates_ExtensionFilter}" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{DynamicResource Duplicates_MinSize}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="6"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Duplicates.MinSizeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Grid.Column="8"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="72"
                                                  MaxWidth="90"
                                                  ItemsSource="{Binding Duplicates.SizeUnitOptions}"
                                                  SelectedItem="{Binding Duplicates.SelectedSizeUnit, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                        <ComboBox Grid.Column="10"
                                                  Style="{StaticResource ThemeSelectorComboBoxStyle}"
                                                  MinWidth="140"
                                                  MaxWidth="180"
                                                  ItemsSource="{Binding Duplicates.SortOptions}"
                                                  SelectedItem="{Binding Duplicates.SelectedSort, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  ToolTip="{DynamicResource Duplicates_SortBy}" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Duplicates_MinCopies}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding Duplicates.MinCopyCountText, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{DynamicResource Duplicates_Find}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Duplicates.AnalyzeCommand}"
                                                    Margin="0,0,8,0"
                                                    MinWidth="130" />
                                            <Button Content="{DynamicResource Duplicates_Cancel}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding Duplicates.CancelAnalyzeCommand}"
                                                    Margin="0,0,8,0"
                                                    MinWidth="120" />
                                            <Button Content="{DynamicResource Duplicates_ApplyFilters}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Duplicates.ApplyDisplayFiltersCommand}"
                                                    Margin="0,0,8,0"
                                                    MinWidth="120" />
                                            <Button Content="{DynamicResource Duplicates_ClearFilters}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Duplicates.ClearFiltersCommand}"
                                                    MinWidth="120" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="4">
                                        <ProgressBar Height="4"
                                                     IsIndeterminate="{Binding Duplicates.IsAnalyzing}"
                                                     Visibility="{Binding Duplicates.IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Duplicates.StatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Duplicates.ProgressText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Duplicates.IsAnalyzing, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Duplicates_IncompleteWarning}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Duplicates.FromIncompleteScanVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Duplicates_AnalysisIncompleteWarning}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Duplicates.AnalysisIncompleteVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource Duplicates_ResultsStale}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Duplicates.ResultsStale, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Duplicates_Card_Groups}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Duplicates.GroupsCountText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Duplicates_Card_Files}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Duplicates.FilesCountText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Duplicates_Card_Savings}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Duplicates.SavingsText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="6" Style="{StaticResource SummaryCardStyle}" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Duplicates_Card_Analyzed}" Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Duplicates.AnalyzedFilesText}" Style="{StaticResource MetricValueStyle}" FontSize="15" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24"
                                            Visibility="{Binding Duplicates.HasScanRoot, Converter={StaticResource BoolToVisInvert}}">
                                    <TextBlock Text="{DynamicResource Duplicates_EmptyTitle}" Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource Duplicates_EmptySubtitle}" Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="24">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Duplicates.HasScanRoot}" Value="True" />
                                                        <Condition Binding="{Binding Duplicates.HasResults}" Value="False" />
                                                        <Condition Binding="{Binding Duplicates.IsAnalyzing}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource Duplicates_NoResultsTitle}" Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource Duplicates_NoResultsSubtitle}" Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <DockPanel Visibility="{Binding Duplicates.HasResults, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="{DynamicResource Duplicates_SavingsDisclaimer}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Duplicates.SkippedFailedText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{DynamicResource Duplicates_OpenContainingFolder}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Duplicates.OpenContainingFolderCommand}"
                                                    Margin="0,0,8,0" />
                                            <Button Content="{DynamicResource Duplicates_CopyPath}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding Duplicates.CopyPathCommand}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ListBox ItemsSource="{Binding Duplicates.Groups}"
                                             SelectedItem="{Binding Duplicates.SelectedGroup, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                          Margin="0,0,0,8"
                                                          Background="{DynamicResource BgPanelBrush}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          BorderBrush="{DynamicResource BorderBrushKey}"
                                                          BorderThickness="1"
                                                          Padding="8,6">
                                                    <Expander.Header>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding HeaderText}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{DynamicResource Duplicates_HashLabel}" />
                                                                <Run Text=": " />
                                                                <Run Text="{Binding ContentHashSha256}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <DataGrid ItemsSource="{Binding Files}"
                                                              SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                                              Style="{StaticResource LargestFilesDataGridStyle}"
                                                              MaxHeight="220"
                                                              Margin="0,8,0,0"
                                                              AutoGenerateColumns="False">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" MinWidth="100"
                                                                                Header="{DynamicResource Duplicates_ColumnName}" />
                                                            <DataGridTextColumn Binding="{Binding SizeText}" Width="90" MinWidth="70"
                                                                                Header="{DynamicResource Duplicates_ColumnSize}" />
                                                            <DataGridTextColumn Binding="{Binding ModifiedText}" Width="130" MinWidth="100"
                                                                                Header="{DynamicResource Duplicates_ColumnModified}" />
                                                            <DataGridTextColumn Binding="{Binding FullPath}" Width="2*" MinWidth="160"
                                                                                Header="{DynamicResource Duplicates_ColumnPath}" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Expander>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Treemap -->
                    <TabItem Header="{DynamicResource Treemap_Title}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Treemap_Back}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Treemap.BackCommand}"
                                                MinWidth="72"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Treemap_Home}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Treemap.HomeCommand}"
                                                MinWidth="100"
                                                Margin="0,0,12,0" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Treemap.Breadcrumbs}"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                    <TextBlock Text="›"
                                                               Margin="0,0,4,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="{Binding DisplayName}"
                                                            Command="{Binding DataContext.Treemap.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{DynamicResource AccentBrush}"
                                                            Cursor="Hand"
                                                            Padding="2,0"
                                                            FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding Treemap.HasScanRoot, Converter={StaticResource BoolToVisInvert}}">
                                    <TextBlock Text="{DynamicResource Treemap_NoScanResults}" Style="{StaticResource EmptyTitleStyle}" />
                                    <TextBlock Text="{DynamicResource Treemap_EmptySubtitle}" Style="{StaticResource EmptySubtitleStyle}" />
                                </StackPanel>

                                <controls:TreemapView Grid.Column="0"
                                                      DataContext="{Binding Treemap}"
                                                      Visibility="{Binding Treemap.HasScanRoot, Converter={StaticResource BoolToVis}}" />

                                <Border Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Padding="10,8"
                                        MinWidth="140"
                                        Style="{StaticResource CardStyle}"
                                        Visibility="{Binding Treemap.ShowLegend, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Treemap_Legend}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Treemap.LegendItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding BrushKey, Converter={StaticResource ResourceBrush}}" />
                                                        <TextBlock Text="{Binding Label}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Treemap_SelectedItem}"
                                                   Style="{StaticResource MetricLabelStyle}" />
                                        <TextBlock Text="{Binding Treemap.SelectedName}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Treemap.SelectedPath}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{DynamicResource Treemap_LogicalSize}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Treemap.SelectedSizeText}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Text="{DynamicResource Treemap_Percentage}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Treemap.SelectedPercentText}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding Treemap.SelectedTypeText}"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Treemap.HoverStatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{DynamicResource Treemap_PartialResults}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Treemap.FromIncompleteScanVisible, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Treemap_OpenContainingFolder}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Treemap.OpenContainingFolderCommand}"
                                                Margin="0,0,0,8"
                                                MinWidth="160" />
                                        <Button Content="{DynamicResource Treemap_CopyPath}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Treemap.CopyPathCommand}"
                                                MinWidth="160" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Comparison_Title}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Comparison_SaveTitle}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,0,8" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource Comparison_SaveButton}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Comparison.SaveSnapshotCommand}"
                                                    Margin="8,0,0,0"
                                                    MinWidth="120" />
                                            <TextBox Text="{Binding Comparison.SnapshotName, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Height="32"
                                                     IsEnabled="{Binding Comparison.HasCurrentScan}" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource Comparison_SaveHint}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button Content="{DynamicResource Comparison_ImportButton}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Comparison.ImportSnapshotCommand}"
                                                Margin="0,0,0,8"
                                                MinWidth="120" />
                                        <Button Content="{DynamicResource Comparison_ExportButton}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Comparison.ExportSnapshotCommand}"
                                                Margin="0,0,0,8"
                                                MinWidth="120" />
                                        <Button Content="{DynamicResource Comparison_RefreshButton}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding Comparison.RefreshSnapshotsCommand}"
                                                Margin="0,0,0,8"
                                                MinWidth="120" />
                                        <Button Content="{DynamicResource Comparison_CancelButton}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding Comparison.CancelWorkCommand}"
                                                MinWidth="120"
                                                Visibility="{Binding Comparison.IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource Comparison_LeftSnapshot}"
                                                       Style="{StaticResource MetricLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding Comparison.Snapshots}"
                                                      SelectedItem="{Binding Comparison.SelectedLeft, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Comparison.LeftMetaText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource Comparison_RightSnapshot}"
                                                       Style="{StaticResource MetricLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding Comparison.Snapshots}"
                                                      SelectedItem="{Binding Comparison.SelectedRight, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Comparison.RightMetaText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                            <Button Content="{DynamicResource Comparison_CompareButton}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding Comparison.CompareCommand}"
                                                    Margin="0,0,0,8"
                                                    MinWidth="120" />
                                            <Button Content="{DynamicResource Comparison_DeleteButton}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Command="{Binding Comparison.DeleteSnapshotCommand}"
                                                    CommandParameter="{Binding Comparison.SelectedLeft}"
                                                    MinWidth="120" />
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{DynamicResource Comparison_FilterLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <ComboBox Width="160"
                                                      ItemsSource="{Binding Comparison.FilterOptions}"
                                                      SelectedItem="{Binding Comparison.SelectedFilter, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Margin="0,0,16,0" />
                                            <TextBlock Text="{DynamicResource Comparison_SortLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <ComboBox Width="180"
                                                      ItemsSource="{Binding Comparison.SortOptions}"
                                                      SelectedItem="{Binding Comparison.SelectedSort, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" Columns="4">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Comparison_TotalDelta}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Comparison.TotalDeltaText}" FontSize="18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
                                                        <Setter Property="FontSize" Value="18" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Comparison.TotalDeltaPositive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Comparison.TotalDeltaNegative}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0">
                                                <Run Text="{Binding Comparison.LeftTotalText}" />
                                                <Run Text=" → " />
                                                <Run Text="{Binding Comparison.RightTotalText}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Comparison_AddedFiles}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Comparison.AddedCountText}"
                                                       Style="{StaticResource MetricValueStyle}"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Comparison_RemovedFiles}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Comparison.RemovedCountText}"
                                                       Style="{StaticResource MetricValueStyle}"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Comparison_ChangedFiles}" Style="{StaticResource MetricLabelStyle}" />
                                            <TextBlock Text="{Binding Comparison.ChangedCountText}"
                                                       Style="{StaticResource MetricValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Grid.Row="2">
                                    <DataGrid ItemsSource="{Binding Comparison.FilteredFileRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              HeadersVisibility="Column"
                                              Visibility="{Binding Comparison.ShowFilteredFileGrid, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnName}" Binding="{Binding Name}" Width="180" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding RelativePath}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnSize}" Binding="{Binding SizeText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnKind}" Binding="{Binding Kind}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid ItemsSource="{Binding Comparison.FilteredFolderRows}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              HeadersVisibility="Column"
                                              Visibility="{Binding Comparison.ShowFilteredFolderGrid, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnLeft}" Binding="{Binding LeftText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnRight}" Binding="{Binding RightText}" Width="110" />
                                            <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TabControl Style="{StaticResource WorkspaceTabControlStyle}"
                                                Visibility="{Binding Comparison.ShowDefaultResultTabs, Converter={StaticResource BoolToVis}}">
                                        <TabItem Header="{DynamicResource Comparison_GrowingFolders}">
                                            <DataGrid ItemsSource="{Binding Comparison.GrowingFolders}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnLeft}" Binding="{Binding LeftText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnRight}" Binding="{Binding RightText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_ShrinkingFolders}">
                                            <DataGrid ItemsSource="{Binding Comparison.ShrinkingFolders}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding Name}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnLeft}" Binding="{Binding LeftText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnRight}" Binding="{Binding RightText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_AddedFiles}">
                                            <DataGrid ItemsSource="{Binding Comparison.AddedFiles}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnName}" Binding="{Binding Name}" Width="180" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding RelativePath}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnSize}" Binding="{Binding SizeText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_RemovedFiles}">
                                            <DataGrid ItemsSource="{Binding Comparison.RemovedFiles}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnName}" Binding="{Binding Name}" Width="180" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding RelativePath}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnSize}" Binding="{Binding SizeText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_ChangedFiles}">
                                            <DataGrid ItemsSource="{Binding Comparison.ChangedFiles}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnName}" Binding="{Binding Name}" Width="180" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnPath}" Binding="{Binding RelativePath}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_Categories}">
                                            <DataGrid ItemsSource="{Binding Comparison.CategoryChanges}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnCategory}" Binding="{Binding Label}" Width="*" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnLeft}" Binding="{Binding LeftText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnRight}" Binding="{Binding RightText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{DynamicResource Comparison_Extensions}">
                                            <DataGrid ItemsSource="{Binding Comparison.ExtensionChanges}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      EnableRowVirtualization="True"
                                                      VirtualizingPanel.IsVirtualizing="True"
                                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                                      HeadersVisibility="Column"
                                                      Margin="0,8,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnExtension}" Binding="{Binding Label}" Width="120" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnLeft}" Binding="{Binding LeftText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnRight}" Binding="{Binding RightText}" Width="110" />
                                                    <DataGridTextColumn Header="{DynamicResource Comparison_ColumnDelta}" Binding="{Binding DeltaText}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>

                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Comparison.IncompleteNote}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Comparison.RootsNote}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Comparison.ProgressText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Visibility="{Binding Comparison.IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Comparison.StatusText}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Cleanup_Title}">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Text="{DynamicResource Cleanup_PreviewOnlyHint}"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource Cleanup_LargeFileThreshold}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Cleanup.LargeFileMinMbText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 Height="30" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{DynamicResource Cleanup_OldFileDays}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <TextBox Grid.Column="6"
                                                 Text="{Binding Cleanup.OldFileDaysText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"
                                                 Height="30" />
                                        <TextBlock Grid.Column="8"
                                                   Text="{DynamicResource Cleanup_CategoryFilter}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox Grid.Column="10"
                                                  ItemsSource="{Binding Cleanup.CategoryFilterOptions}"
                                                  SelectedItem="{Binding Cleanup.SelectedCategoryFilter, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                        <TextBlock Grid.Column="12"
                                                   Text="{DynamicResource Cleanup_RiskFilter}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />
                                        <ComboBox Grid.Column="14"
                                                  ItemsSource="{Binding Cleanup.RiskFilterOptions}"
                                                  SelectedItem="{Binding Cleanup.SelectedRiskFilter, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" />
                                        <StackPanel Grid.Column="16" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{DynamicResource Cleanup_SortLabel}"
