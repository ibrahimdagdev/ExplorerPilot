<Window x:Class="ExplorerPilot.App.Views.SystemInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ExplorerPilot.App.Converters"
        xmlns:vm="clr-namespace:ExplorerPilot.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="560"
        Height="640"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance Type=vm:SystemInformationViewModel}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="{Binding WindowTitle}"
                       Style="{StaticResource BrandTitleStyle}"
                       FontSize="18"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="{Binding RefreshButtonText}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    MinWidth="96"
                    VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="2">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True"
                             Width="220"
                             Height="4"
                             Margin="0,0,0,14" />
                <TextBlock Text="{Binding LoadingText}"
                           Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error without data -->
            <Border VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasError}" Value="True" />
                                    <Condition Binding="{Binding HasData}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasData}" Value="True" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <Border Margin="0,0,0,12"
                            Padding="12,10"
                            Background="{DynamicResource BgControlBrush}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WarningMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Margin="0,0,0,12"
                            Padding="12,10"
                            Background="{DynamicResource BgControlBrush}"
                            BorderBrush="{DynamicResource BorderBrushKey}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   Style="{StaticResource MetricLabelStyle}"
                                                                   Margin="0"
                                                                   VerticalAlignment="Top"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Value}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Top" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding PrivacyNote}"
                   Style="{StaticResource MutedTextStyle}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <Button Grid.Row="6"
                Content="{Binding CloseButtonText}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right"
                MinWidth="96"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
    </Grid>
</Window>
