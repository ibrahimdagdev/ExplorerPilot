<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ExplorerPilot.App</RootNamespace>
    <AssemblyName>ExplorerPilot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ExplorerPilot.ico</ApplicationIcon>

    <!-- Application identity & version (single source of truth; no duplicate AssemblyInfo attributes) -->
    <Version>2.0.0-alpha.2</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.2</FileVersion>
    <InformationalVersion>2.0.0-alpha.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>ExplorerPilot</Product>
    <Company>Tasarisoft</Company>
    <Authors>İbrahim Dağ</Authors>
    <Copyright>© 2026 Tasarisoft. All rights reserved.</Copyright>
    <Description>A modern disk space analyzer for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ExplorerPilot.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surface Authors in assembly metadata so About can read it at runtime. -->
    <AssemblyMetadata Include="Authors" Value="İbrahim Dağ" />
    <InternalsVisibleTo Include="ExplorerPilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExplorerPilot.Core\ExplorerPilot.Core.csproj" />
    <ProjectReference Include="..\ExplorerPilot.Infrastructure\ExplorerPilot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

</Project>
